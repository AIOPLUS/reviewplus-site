---
import Logo from './Logo.astro';
import LabelList from './LabelList.astro';
import { brand, footerNav } from '@/config/brand';
import { PIXELS } from '@/config/site';
import { url } from '@/lib/url';

const hasPixels = Boolean(PIXELS.metaPixelId || PIXELS.gadsId);
const socials = [
  { href: brand.social.linkedin, label: 'LinkedIn', path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z' },
  { href: brand.social.instagram, label: 'Instagram', path: 'M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z' },
  { href: brand.social.facebook, label: 'Facebook', path: 'M24 12.07C24 5.41 18.63 0 12 0S0 5.41 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z' },
].filter((s) => s.href);
const year = new Date().getFullYear();
---
<footer class="mt-24">
  <div class="container-rp">
    <div class="grid gap-12 border-b border-line pb-14 lg:grid-cols-[1fr_2.2fr]">
      <div class="grid content-start gap-5">
        <a href={url('/')} class="w-fit" aria-label="Review Plus – home"><Logo size={34} wordmark /></a>
        <form class="grid max-w-[420px] gap-3" data-newsletter novalidate>
          <label for="nb-email" class="text-base font-medium">Abonneer op onze nieuwsbrief</label>
          <div class="flex items-center gap-2 rounded-full border border-line bg-white p-1.5 pl-5 focus-within:border-brand-600">
            <input id="nb-email" name="email" type="email" autocomplete="email" required placeholder="Je e-mailadres"
              class="min-w-0 flex-1 bg-transparent text-[15px] outline-none" aria-describedby="nb-status" />
            <button type="submit" class="btn btn-primary !min-h-[42px] !px-5 shrink-0">Aanmelden</button>
          </div>
          <p id="nb-status" class="hint" aria-live="polite"></p>
        </form>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        {footerNav.map((col) => (
          <div>
            <p class="mb-4 font-medium text-ink">{col.title}</p>
            <ul class="grid gap-3 text-[15px] text-muted">
              {col.links.map((l) => (
                <li><a class="hover:text-brand-600" href={url(l.href)}>{l.label}</a></li>
              ))}
              {col.title === 'Wettelijk' && hasPixels && (
                <li><button type="button" data-open-consent class="cursor-pointer text-left hover:text-brand-600">Cookie-instellingen</button></li>
              )}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-line py-6">
      <p class="text-sm text-muted">Onderdeel van AIO Plus:</p>
      <LabelList plek="footer" />
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 py-8 text-sm text-muted">
      <p>© {year} {brand.name}. Alle rechten voorbehouden.</p>
      {socials.length > 0 && (
        <ul class="flex gap-2" aria-label="Social media">
          {socials.map((s) => (
            <li><a href={s.href} rel="noopener" target="_blank" class="grid size-9 place-items-center rounded-full border border-line text-ink hover:text-brand-600" aria-label={s.label}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
            </a></li>
          ))}
        </ul>
      )}
      <a href={brand.demoBookingUrl} target="_blank" rel="noopener" data-track="demo_klik" data-track-plek="footer" class="btn !min-h-[42px] border-brand-600 text-brand-600 hover:bg-brand-100">
        Boek een demo<span class="sr-only"> (opent in een nieuw tabblad)</span>
      </a>
    </div>
  </div>
</footer>
