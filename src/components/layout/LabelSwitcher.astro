---
/**
 * Labelwisselaar naast het logo: alle labels van AIO Plus, elk met het beeldmerk in de eigen kleur.
 * Werkt zonder JavaScript (<details>); het script sluit hem bij klikken buiten of Escape.
 * Labels staan in src/data/labels.json.
 */
import Logo from './Logo.astro';
import { labels, bundel, labelLink, HUIDIG_LABEL } from '@/lib/labels';
---
<details class="labels relative max-sm:hidden" data-labels>
  <summary
    class="flex cursor-pointer list-none items-center gap-1 rounded-full border border-line px-3 py-1.5 text-[13px] text-muted transition-colors hover:border-brand-600 hover:text-brand-600 [&::-webkit-details-marker]:hidden"
  >
    Labels
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="labels-chevron transition-transform"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <div class="absolute left-0 top-[calc(100%+10px)] z-50 w-[340px] rounded-[20px] border border-line bg-white p-2 shadow-[var(--shadow-card)]">
    <p class="px-3 pb-1.5 pt-2 text-xs text-muted">Onderdeel van AIO Plus</p>
    <ul class="grid gap-0.5">
      {labels.map((l) => {
        const huidig = l.id === HUIDIG_LABEL;
        const inhoud = (
          <>
            <Logo size={26} color={l.kleur} />
            <span class="min-w-0 flex-1">
              <span class:list={['block text-[15px] font-medium', l.status === 'live' ? 'text-ink' : 'text-muted']}>{l.naam}</span>
              {l.omschrijving && <span class="block text-[13px] text-muted">{l.omschrijving}</span>}
            </span>
          </>
        );
        return (
          <li>
            {huidig ? (
              <span class="flex items-center gap-3 rounded-xl bg-brand-100 px-3 py-2.5" aria-current="true">
                {inhoud}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
                <span class="sr-only">(huidige site)</span>
              </span>
            ) : l.status === 'live' ? (
              <a href={labelLink(l, 'wisselaar')} class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-[#fafafa]" data-track="label_klik" data-track-label={l.id}>
                {inhoud}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-muted" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
              </a>
            ) : (
              <span class="flex items-center gap-3 px-3 py-2.5">
                {inhoud}
                <span class="rounded-full bg-[#fdf3dc] px-2.5 py-0.5 text-xs text-[#7a4a00]">Binnenkort</span>
              </span>
            )}
          </li>
        );
      })}
    </ul>
    <div class="mt-1.5 flex items-center justify-between gap-3 border-t border-line px-3 pb-1.5 pt-3">
      <span>
        <span class="block text-sm font-medium text-ink">{bundel.naam}</span>
        {bundel.omschrijving && <span class="block text-[13px] text-muted">{bundel.omschrijving}</span>}
      </span>
      {bundel.status === 'live' ? (
        <a href={labelLink(bundel, 'wisselaar')} class="text-sm text-brand-600 hover:underline" data-track="label_klik" data-track-label={bundel.id}>Bekijk</a>
      ) : (
        <span class="rounded-full bg-[#fdf3dc] px-2.5 py-0.5 text-xs text-[#7a4a00]">Binnenkort</span>
      )}
    </div>
  </div>
</details>

<style>
  .labels[open] .labels-chevron { transform: rotate(180deg); }
</style>

<script>
  const el = document.querySelector<HTMLDetailsElement>('[data-labels]');
  if (el) {
    document.addEventListener('click', (e) => {
      if (el.open && !el.contains(e.target as Node)) el.open = false;
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && el.open) {
        el.open = false;
        el.querySelector('summary')?.focus();
      }
    });
  }
</script>
