---
import { Image } from 'astro:assets';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { DEMO_BOOKING_URL } from '@/config/site';
import { hoofdfuncties } from '@/config/content';
import bg1 from '@/assets/img/bento-bg-1.png';
import bg2 from '@/assets/img/bento-bg-2.png';
import bg3 from '@/assets/img/bento-bg-3.png';
import bgBlauw from '@/assets/img/bento-bg-blauw.png';
import nfcKaart from '@/assets/img/nfc-kaart.png';
import aiAntwoord from '@/assets/img/bento-ai-antwoord.png';
import aiReview from '@/assets/img/bento-ai-review.png';
import appDashboard from '@/assets/img/app-dashboard.jpeg';
import iphone from '@/assets/img/iphone-frame.png';
import dashboardKaart from '@/assets/img/dashboard-kaart.png';
import logoWit from '@/assets/img/logo-wit.png';

interface Props {
  line1?: string;
  line2?: string;
}
const { line1 = 'Ontdek wat', line2 = 'ons uniek maakt' } = Astro.props;
const [verzamelen, ai, overzicht] = hoofdfuncties;

// Kanalen rond de NFC-kaart (telefoon, sterren, Google, Facebook, groei, raket)
const kanalen = [
  { pos: 'left-[10%] top-[12%]', d: 'm12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z' },
  { pos: 'left-1/2 top-[6%] -translate-x-1/2', d: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z' },
  { pos: 'right-[10%] top-[12%]', d: 'M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9a2.2 2.2 0 0 0-2.9-.1ZM12 15l-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 0 1-4 2Z' },
  { pos: 'left-[10%] bottom-[22%]', d: 'M3 3v18h18M7 14l4-4 4 4 5-5' },
  { pos: 'left-1/2 bottom-[4%] -translate-x-1/2', d: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z' },
  { pos: 'right-[10%] bottom-[22%]', d: 'M21.8 10H12v4h5.7A6 6 0 1 1 16 7.8l2.9-2.8A10 10 0 1 0 22 12c0-.7-.1-1.4-.2-2Z' },
];
---
<section class="py-20 lg:py-28" aria-labelledby="bento-title">
  <div class="container-rp">
    <SectionHeader id="bento-title" eyebrow="Belangrijkste functies" line1={line1} line2={line2} class="reveal" />

    <div class="mt-14 grid gap-4 lg:mt-20 lg:grid-cols-2 lg:gap-6">
      <!-- Kaart 1: reviews verzamelen -->
      <article class="reveal relative isolate grid min-h-[520px] overflow-hidden rounded-[var(--radius-card)] bg-brand-50 lg:min-h-[636px]">
        <Image src={bg1} alt="" class="absolute inset-0 -z-10 size-full object-cover" widths={[640, 1280]} sizes="(min-width: 1200px) 640px, 100vw" />
        <div class="relative h-[340px] lg:h-[430px]">
          <svg class="absolute inset-0 size-full text-brand-300" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width=".3">
            <path d="M16 18 Q30 30 42 42 M50 12 V38 M84 18 Q70 30 58 42 M16 72 Q30 64 42 58 M50 92 V64 M84 72 Q70 64 58 58" />
          </svg>
          {kanalen.map((k) => (
            <span class={`absolute grid size-12 place-items-center rounded-full bg-white text-brand-600 shadow-[var(--shadow-card)] ${k.pos}`} aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={k.d} /></svg>
            </span>
          ))}
          <Image src={nfcKaart} alt="Review Plus NFC-kaart: tik met je telefoon en laat direct een review achter" widths={[320, 640]} sizes="320px" class="absolute left-1/2 top-1/2 w-[62%] max-w-[320px] -translate-x-1/2 -translate-y-1/2 -rotate-6 drop-shadow-xl" />
        </div>
        <div class="self-end p-8 lg:p-10">
          <h3 class="title">{verzamelen.titel}</h3>
          <p class="body-muted mt-2 max-w-[420px]">{verzamelen.tekst}</p>
        </div>
      </article>

      <!-- Kaart 2: AI-reacties -->
      <article class="reveal relative isolate grid min-h-[520px] content-between overflow-hidden rounded-[var(--radius-card)] bg-brand-50 lg:min-h-[636px]">
        <Image src={bg2} alt="" class="absolute inset-0 -z-10 size-full object-cover" widths={[640, 1280]} sizes="(min-width: 1200px) 640px, 100vw" />
        <div class="p-8 lg:p-14">
          <h3 class="title max-w-[420px]">{ai.titel}</h3>
          <p class="body-muted mt-2 max-w-[420px]">{ai.tekst}</p>
        </div>
        <div class="relative grid gap-3 px-6 pb-10 lg:px-10 lg:pb-16">
          <Image src={aiAntwoord} alt="AI-antwoord: 'Hi Alysa. Bedankt voor je review! We hopen je snel weer te zien!'" widths={[560, 1100]} sizes="(min-width: 1200px) 560px, 90vw" class="relative z-10 w-full rounded-xl shadow-[var(--shadow-card)]" />
          <Image src={aiReview} alt="Vijfsterrenreview van Alysa S." widths={[480, 960]} sizes="(min-width: 1200px) 480px, 80vw" class="mx-auto -mt-6 w-[88%] rounded-xl opacity-95 shadow-[var(--shadow-card)]" />
        </div>
      </article>
    </div>

    <div class="mt-4 grid gap-4 lg:mt-6 lg:grid-cols-[1.4fr_1fr] lg:gap-6">
      <!-- Kaart 3: dashboard, breed -->
      <article class="reveal relative isolate grid min-h-[424px] overflow-hidden rounded-[var(--radius-card)] bg-brand-50 md:grid-cols-[1fr_1.1fr]">
        <Image src={bg3} alt="" class="absolute inset-0 -z-10 size-full object-cover" widths={[760, 1500]} sizes="(min-width: 1200px) 760px, 100vw" />
        <div class="self-start p-8 lg:p-16 lg:pr-0">
          <h3 class="title">{overzicht.titel}</h3>
          <p class="body-muted mt-2 max-w-[320px]">{overzicht.tekst}</p>
        </div>
        <div class="relative h-[320px] md:h-auto">
          <div class="absolute bottom-[-40%] left-[12%] w-[230px] rotate-[12deg] md:bottom-[-18%]">
            <Image src={appDashboard} alt="Review Plus-app: dashboard met gemiddelde score 4,8" widths={[220, 440]} sizes="220px" class="absolute left-[5%] top-[2.5%] w-[90%] rounded-[28px]" />
            <Image src={iphone} alt="" widths={[230, 460]} sizes="230px" class="relative w-full" />
          </div>
          <Image src={dashboardKaart} alt="" widths={[280, 560]} sizes="280px" class="absolute bottom-6 right-4 w-[58%] max-w-[300px] rounded-xl shadow-[var(--shadow-card)]" />
        </div>
      </article>

      <!-- Kaart 4: demo -->
      <article class="reveal relative isolate grid min-h-[360px] content-between overflow-hidden rounded-[var(--radius-card)] bg-brand-600 p-8 text-white lg:min-h-[424px] lg:p-14">
        <Image src={bgBlauw} alt="" class="absolute inset-0 -z-10 size-full object-cover" widths={[540, 1080]} sizes="(min-width: 1200px) 540px, 100vw" />
        <Image src={logoWit} alt="" width={96} height={96} class="h-20 w-auto brightness-0 invert lg:h-24" />
        <div class="grid gap-6">
          <h3 class="text-[32px] font-medium leading-tight lg:text-[40px]">Digitale koffie?</h3>
          <a href={DEMO_BOOKING_URL} target="_blank" rel="noopener" data-track="demo_klik" data-track-plek="bento" class="btn btn-white w-fit">Boek een demo<span class="sr-only"> (opent in een nieuw tabblad)</span></a>
        </div>
      </article>
    </div>
  </div>
</section>
