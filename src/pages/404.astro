---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { url } from '@/lib/url';
---
<BaseLayout title="Pagina niet gevonden | Review Plus" description="Deze pagina bestaat niet (meer)." path="/404" noindex page="404">
  <PageHero line1="Pagina niet" line2="gevonden" text="Deze pagina bestaat niet (meer). Misschien vind je hieronder wat je zoekt.">
    <div class="mt-4 flex flex-wrap justify-center gap-3">
      <a href={url('/')} class="btn btn-primary">Naar de homepage</a>
      <a href={url('/features')} class="btn btn-soft">Het product</a>
      <a href={url('/plans')} class="btn btn-soft">Prijzen</a>
      <a href={url('/contact')} class="btn btn-soft">Contact</a>
    </div>
  </PageHero>
</BaseLayout>
