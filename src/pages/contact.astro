---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { brand } from '@/config/brand';
import { DEMO_BOOKING_URL, LEAD } from '@/config/site';
import { breadcrumbSchema } from '@/lib/schema';
import { url } from '@/lib/url';
---
<BaseLayout
  title="Contact | Review Plus"
  description="Neem contact op met Review Plus. Stel je vraag via het formulier of mail naar support@reviewplus.io; we reageren binnen één werkdag. Liever direct zien hoe het werkt? Boek een demo."
  path="/contact"
  page="contact"
  schemas={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }])]}
>
  <PageHero line1="Neem" line2="contact op" text="Wil je contact met ons opnemen? Vul het formulier in, dan nemen we snel contact met je op." compact />

  <section class="pb-10" aria-label="Contactformulier">
    <div class="container-rp grid gap-8 lg:grid-cols-[1fr_380px]">
      <form
        class="card grid gap-5 p-6 md:p-10"
        novalidate
        data-contact
        data-webhook={LEAD.webhookUrl}
        data-turnstile={LEAD.turnstileSiteKey}
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="field">
            <label for="voornaam">Voornaam <span class="req" aria-hidden="true">*</span></label>
            <input id="voornaam" name="voornaam" class="input" autocomplete="given-name" required />
          </div>
          <div class="field">
            <label for="achternaam">Achternaam <span class="req" aria-hidden="true">*</span></label>
            <input id="achternaam" name="achternaam" class="input" autocomplete="family-name" required />
          </div>
          <div class="field">
            <label for="email">E-mailadres <span class="req" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" class="input" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="telefoon">Telefoonnummer</label>
            <input id="telefoon" name="telefoon" type="tel" class="input" autocomplete="tel" />
          </div>
          <div class="field sm:col-span-2">
            <label for="bedrijf">Bedrijfsnaam</label>
            <input id="bedrijf" name="bedrijf" class="input" autocomplete="organization" />
          </div>
          <div class="field sm:col-span-2">
            <label for="bericht">Bericht <span class="req" aria-hidden="true">*</span></label>
            <textarea id="bericht" name="bericht" class="input" required></textarea>
          </div>
        </div>
        <input type="hidden" name="plan" />
        <!-- Honeypot tegen spam: echte bezoekers zien dit veld niet -->
        <div class="sr-only" aria-hidden="true">
          <label for="website_url">Laat dit veld leeg</label>
          <input id="website_url" name="website_url" tabindex="-1" autocomplete="off" />
        </div>
        <label class="check">
          <input type="checkbox" name="akkoord" required />
          <span>Ik ga akkoord met de <a class="text-brand-600 underline" href={url('/privacy-policy')}>privacyverklaring</a>. <span class="req" aria-hidden="true">*</span></span>
        </label>
        <div data-turnstile-slot class="min-h-[65px]" hidden={!LEAD.turnstileSiteKey}></div>
        <p class="error" data-form-error hidden role="alert"></p>
        <button type="submit" class="btn btn-primary btn-lg w-full sm:w-fit">Verstuur bericht</button>
      </form>

      <aside class="grid content-start gap-4">
        <div class="soft-card grid gap-2 p-6">
          <p class="font-medium text-ink">Liever direct zien hoe het werkt?</p>
          <p class="body-muted">Plan een vrijblijvende demo van 30 minuten. We nemen je Google-bedrijfsprofiel samen onder de loep.</p>
          <a href={DEMO_BOOKING_URL} target="_blank" rel="noopener" data-track="demo_klik" data-track-plek="contact" class="btn btn-primary mt-2 w-fit">Boek een demo<span class="sr-only"> (opent in een nieuw tabblad)</span></a>
        </div>
        <div class="soft-card grid gap-2 p-6">
          <p class="font-medium text-ink">Mail ons</p>
          <a href={`mailto:${brand.email}`} class="text-brand-600 underline">{brand.email}</a>
          <p class="body-muted">We reageren binnen één werkdag.</p>
        </div>
        <div class="soft-card grid gap-2 p-6">
          <p class="font-medium text-ink">Al klant?</p>
          <a href={brand.appLoginUrl} class="text-brand-600 underline">Log in op app.reviewplus.io</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="container-rp" data-contact-success hidden>
    <div class="soft-card mx-auto grid max-w-[640px] justify-items-center gap-4 p-10 text-center" tabindex="-1" data-success-focus>
      <span class="grid size-14 place-items-center rounded-full bg-success-bg text-2xl text-success" aria-hidden="true">✓</span>
      <h2 class="heading-md">Bedankt voor je bericht!</h2>
      <p class="text-ink-soft">We nemen binnen één werkdag contact met je op. Een kopie van je bericht staat in je mailbox.</p>
    </div>
  </section>
</BaseLayout>

<script>
  import { track } from '@/lib/client/analytics';
  import { validateEmail } from '@/lib/validation';

  declare global {
    interface Window {
      turnstile?: {
        render: (el: Element, opts: Record<string, unknown>) => string;
        getResponse: (id?: string) => string | undefined;
        reset: (id?: string) => void;
      };
    }
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const webhook = form.dataset.webhook ?? '';
    const siteKey = form.dataset.turnstile ?? '';
    const errorBox = form.querySelector<HTMLElement>('[data-form-error]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    let widgetId: string | undefined;

    const plan = new URLSearchParams(location.search).get('plan');
    if (plan) {
      (form.elements.namedItem('plan') as HTMLInputElement).value = plan;
      const bericht = form.elements.namedItem('bericht') as HTMLTextAreaElement;
      if (!bericht.value) bericht.value = `Ik heb interesse in Review Plus Online (${plan}).`;
    }

    // Turnstile pas laden zodra iemand het formulier gebruikt.
    const loadTurnstile = () => {
      const slot = form.querySelector('[data-turnstile-slot]');
      if (!siteKey || !slot || widgetId !== undefined || document.querySelector('script[data-ts]')) return;
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.dataset.ts = '';
      s.onload = () => { widgetId = window.turnstile?.render(slot, { sitekey: siteKey, language: 'nl', appearance: 'interaction-only', action: 'contact' }); };
      document.head.appendChild(s);
    };
    form.addEventListener('focusin', loadTurnstile, { once: true });

    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const val = (name: string) => field(name)?.value.trim() ?? '';
    const fail = (message: string, focus?: HTMLElement) => {
      errorBox.textContent = message;
      errorBox.hidden = false;
      focus?.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));

      for (const name of ['voornaam', 'achternaam', 'bericht']) {
        if (!val(name)) {
          field(name).setAttribute('aria-invalid', 'true');
          return fail('Vul alle verplichte velden in.', field(name));
        }
      }
      const email = validateEmail(val('email'));
      if (!email.ok) {
        field('email').setAttribute('aria-invalid', 'true');
        return fail(email.error ?? 'Vul een geldig e-mailadres in.', field('email'));
      }
      if (!(field('akkoord') as HTMLInputElement).checked) return fail('Ga akkoord met de privacyverklaring.', field('akkoord'));
      if (val('website_url')) return; // honeypot
      if (!webhook) return fail('Het formulier is nog niet gekoppeld. Mail ons via support@reviewplus.io.');

      submit.disabled = true;
      submit.textContent = 'Bezig met versturen…';
      try {
        let token: string | null = null;
        if (siteKey) {
          loadTurnstile();
          for (let i = 0; i < 24 && !token; i++) {
            token = window.turnstile?.getResponse(widgetId) || null;
            if (!token) await new Promise((r) => setTimeout(r, 250));
          }
          if (!token) throw new Error('turnstile');
        }
        const res = await fetch(webhook, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            request_type: 'contact',
            lead_source: 'site',
            submitted_at: new Date().toISOString(),
            pagina: location.href,
            contact: { voornaam: val('voornaam'), achternaam: val('achternaam'), email: email.value, telefoon: val('telefoon') },
            bedrijf: { naam: val('bedrijf') },
            plan: val('plan') || null,
            bericht: val('bericht'),
            turnstile_token: token,
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        track('contact_verzonden', { plan: val('plan') || 'geen' });
        form.closest('section')!.hidden = true;
        const success = document.querySelector<HTMLElement>('[data-contact-success]')!;
        success.hidden = false;
        success.querySelector<HTMLElement>('[data-success-focus]')?.focus();
      } catch (err) {
        window.turnstile?.reset(widgetId);
        fail(err instanceof Error && err.message === 'turnstile'
          ? 'De beveiligingscontrole is nog niet afgerond. Staat er een vakje "Ik ben geen robot"? Vink het aan en klik daarna opnieuw op versturen.'
          : 'Versturen is niet gelukt. Probeer het opnieuw of mail naar support@reviewplus.io.');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Verstuur bericht';
      }
    });
  }
</script>
